{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "rv1126b_ipc",
      "displayName": "rv1126b_ipc Release",
      "description": "使用 Rockchip ARM hard-float 工具链构建 Release 版本",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build",
      "toolchainFile": "${sourceDir}/../../cmake/toolchains/arm-rockchip1240-gnueabihf.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "DARKOS_BUILD_HAL_IMPLEMENTATIONS": "ON",
        "DARKOS_PLATFORM": "auto",
        "DARKOS_VENDOR": "rockchip",
        "DARKOS_SOC": "rv1126b",
        "DARKOS_OUTPUT_ROOT": "${sourceDir}/../../output/rv1126b_ipc"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "rv1126b_ipc",
      "displayName": "Build rv1126b_ipc Release",
      "configurePreset": "rv1126b_ipc"
    }
  ]
}
