{
  // 在 VSCode 左侧资源管理器中隐藏这些文件/目录。
  "files.exclude": {
    "**/.git": true,
    "**/.svn": true,
    "**/.hg": true,
    "**/CVS": true,
    "**/.DS_Store": true,
    "**/Thumbs.db": true,
    "**/node_modules": true,
    "**/bower_components": true,
    "**/__pycache__": true,
    "**/*.pyc": true,
    "**/.pytest_cache": true,
    "**/.mypy_cache": true,
    "**/.ruff_cache": true,
    "**/.cache": true,
    "**/dist": true,
    "**/build": true,
    "**/out": true,
    "**/target": true,
    "**/cmake-build-*": true,
    "**/.idea": true,
    "**/*.o": true,
    "**/*.a": true,
    "**/*.so": true,
    "**/*.d": true
  },
  // 在 VSCode 搜索中排除这些文件/目录。
  "search.exclude": {
    "**/.git": true,
    "**/node_modules": true,
    "**/bower_components": true,
    "**/__pycache__": true,
    "**/*.pyc": true,
    "**/.pytest_cache": true,
    "**/.mypy_cache": true,
    "**/.ruff_cache": true,
    "**/.cache": true,
    "**/dist": true,
    "**/build": true,
    "**/out": true,
    "**/target": true,
    "**/cmake-build-*": true,
    "**/*.o": true,
    "**/*.a": true,
    "**/*.so": true,
    "**/*.d": true,
    "**/cmake*": true
  },
  // 在 VSCode 文件监视器中排除这些文件/目录。
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/**": true,
    "**/bower_components/**": true,
    "**/__pycache__/**": true,
    "**/.cache/**": true,
    "**/dist/**": true,
    "**/build/**": true,
    "**/out/**": true,
    "**/target/**": true,
    "**/cmake-build-*/**": true
  },
  // 在 VSCode 资源管理器中排除 .gitignore 中列出的文件/目录。
  "explorer.excludeGitIgnore": true
}